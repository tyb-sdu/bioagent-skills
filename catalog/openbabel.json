{
  "id": "openbabel",
  "name": "Open Babel",
  "aliases": ["obabel"],
  "summary": "Chemical file-format conversion and molecular preparation toolkit.",
  "tasks": ["molecule-preparation", "ligand-preparation", "chemical-format-conversion"],
  "install": {
    "kind": "conda",
    "platforms": ["linux", "macos", "windows"],
    "architectures": {"linux": ["x86_64", "aarch64", "ppc64le"], "macos": ["x86_64", "aarch64"], "windows": ["x86_64"]},
    "automatic": true,
    "environment": "bio-openbabel",
    "channel": "conda-forge",
    "package": "openbabel=3.2.1"
  },
  "verify": {"argv": ["obabel", "-V"]},
  "notes": ["The reviewed conda-forge route checks the CLI, not every conversion plugin or Python binding. Different formats and stereochemistry still require scientific validation."],
  "sources": [
    {"type": "installation", "url": "https://openbabel.org/docs/Installation/install.html"},
    {"type": "package", "url": "https://github.com/conda-forge/openbabel-feedstock/blob/main/README.md"},
    {"type": "package-release", "url": "https://api.anaconda.org/release/conda-forge/openbabel/3.2.1"}
  ]
}
